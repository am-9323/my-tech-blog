---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { AUTHOR } from '../consts';
---

<section class="profile" aria-label="プロフィール">
  <div class="head">
    {/*
      表示サイズ（4rem = 64px）の2倍で書き出し、高解像度の画面でもぼやけないようにする
      元画像は横長なので、fit="cover" で中央を正方形に切り抜く（指定しないと縦横比が崩れる）
    */}
    <Image src={avatar} alt="" width={128} height={128} fit="cover" class="avatar" />
    <p class="name">{AUTHOR.name}</p>
  </div>
  <p class="bio">{AUTHOR.bio}</p>
  <ul class="links">
    <li>
      <a href={AUTHOR.github} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path
            fill="currentColor"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        GitHub
      </a>
    </li>
  </ul>
</section>

<style>
  .profile {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .head {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .avatar {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border: 1px solid var(--border);
    /* 丸く切り抜くと耳の先が欠けるので、角丸の四角にする */
    border-radius: 12px;
  }
  .name {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: bold;
  }
  .bio {
    margin: 0.75rem 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
