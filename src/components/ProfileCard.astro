---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import { AUTHOR } from '../consts';
import GitHubIcon from './icons/GitHubIcon.astro';
---

<section class="profile" aria-label="プロフィール">
  <div class="head">
    {/*
      表示サイズ（4rem = 64px）の2倍で書き出し、高解像度の画面でもぼやけないようにする
      元画像は横長なので、fit="cover" で中央を正方形に切り抜く（指定しないと縦横比が崩れる）
    */}
    <Image src={avatar} alt="" width={128} height={128} fit="cover" class="avatar" />
    <p class="name">{AUTHOR.name}</p>
  </div>
  <p class="bio">{AUTHOR.bio}</p>
  <ul class="links">
    <li>
      <a href={AUTHOR.github} target="_blank" rel="noopener noreferrer">
        <GitHubIcon />
        GitHub
      </a>
    </li>
  </ul>
</section>

<style>
  .profile {
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .head {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }
  .avatar {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border: 1px solid var(--border);
    /* 丸く切り抜くと耳の先が欠けるので、角丸の四角にする */
    border-radius: 12px;
  }
  .name {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: bold;
  }
  .bio {
    margin: 0.75rem 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
