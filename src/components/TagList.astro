---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul>
      {tags.map((tag) => (
        <li>
          <a href={`/tags/${tag}/`}>#{tag}</a>
        </li>
      ))}
    </ul>
  )
}

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
</style>
